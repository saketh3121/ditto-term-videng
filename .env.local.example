# Copy to .env.local and fill in. Never commit .env.local.
#
# Google OAuth (NextAuth) — same model as the Health site.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Run `npx auth secret` to generate, or `openssl rand -base64 32`.
AUTH_SECRET=your-generated-secret

# Restrict sign-in to this workspace domain (advisors only). Optional —
# defaults to joinditto.in in config/auth.ts.
ALLOWED_EMAIL_DOMAIN=joinditto.in

# Always allowed in; self-seeds its own content/advisors/ entry with
# role: "admin" on first sign-in. Optional — defaults to pappu.naga@joinditto.in
# in config/auth.ts.
SUPER_ADMIN_EMAIL=pappu.naga@joinditto.in

# Long random string for the access-request approve link (see docs/AUTH.md).
# Must match the Apps Script poller's APPROVAL_SECRET Script Property exactly.
APPROVAL_SECRET=generate-a-long-random-string

# Recommended — not required by the approve-access route itself.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin CMS / advisor allowlist ---------------------------------------
# Fine-grained GitHub PAT (or GitHub App installation token) scoped to
# sakdittoeth/bliss-term-insurance only, with Contents: Read & write and
# Pull requests: Read & write. Used server-side only (lib/cms/github.ts) —
# never sent to the client. Also used to write content/advisors/*.json and
# pending-requests/*.json (see docs/AUTH.md) — a signed-in advisor's role
# there (role: "admin" | "member") is the single source of truth for who can
# view /admin/review and approve/reject/merge pending content changes; any
# allowlisted advisor can already reach /admin and submit edits.
CMS_GITHUB_TOKEN=github_pat_xxx

# --- Control Panel chat-log audit trail -----------------------------------
# Separate repo from CMS_REPO_OWNER/CMS_REPO_NAME above — see config/chat-log.ts
# for why (writes here must never trigger this app's own Vercel deploy).
CHATLOG_GITHUB_OWNER=your-github-username-or-org
CHATLOG_GITHUB_REPO=your-chat-log-repo-name
# Optional — defaults to "main" if unset.
CHATLOG_GITHUB_BRANCH=main
# Optional — a dedicated fine-grained PAT (Contents: Read and write only,
# scoped to CHATLOG_GITHUB_REPO) is preferred over reusing CMS_GITHUB_TOKEN.
# Falls back to CMS_GITHUB_TOKEN above if unset.
CHATLOG_GITHUB_TOKEN=github_pat_xxx
